# Copy this file to .env and fill in your keys

# --- Groq API (https://console.groq.com/keys) ---
# Free tier: 14,400 req/day, 500k tokens/min — more than enough
GROQ_API_KEY=gsk_your_key_here

# --- LLM Model Selection ---
# Generation model (fast, cheap, good quality)
GROQ_GENERATION_MODEL=llama-3.1-8b-instant

# Judge model (better reasoning for G-Eval evaluation)
GROQ_JUDGE_MODEL=llama-3.3-70b-versatile

# Ollama local fallback (used if Groq is unavailable)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# --- Pipeline Config ---
BRAND=Uber_Support
DATA_PATH=twcs.csv
INTENT_MODEL=sentence-transformers/paraphrase-mpnet-base-v2
EMBED_MODEL=BAAI/bge-small-en-v1.5
SETFIT_MODEL_PATH=models/setfit_uber
FAISS_INDEX_PATH=models/uber_faiss.index
FAISS_META_PATH=models/uber_faiss_meta.json
FEW_SHOT_DATA=data/few_shot_train.json
GOLDEN_EVAL_PATH=eval/golden_eval.json

# Number of shots per intent class for SetFit training
SHOTS_PER_CLASS=16

# RAG retrieval
TOP_K_RETRIEVAL=5

# Escalation thresholds
CONFIDENCE_THRESHOLD=0.65
SENTIMENT_THRESHOLD=-0.65
RETRIEVAL_SCORE_THRESHOLD=0.48
